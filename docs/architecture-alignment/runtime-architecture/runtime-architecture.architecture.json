  "cards": [
    {
      "dot": "cyan",
      "title": "Scraped calendar sources",
      "items": [
        "Stage 2 scrapes club booking systems: Bookup, Sportello, Forumbooking, StyledCalendar, Outlook, Google Calendar, plain iCal feeds, and BRP Exigo",
        "Credentialed sources use stored per-club scraper credentials (scraper_credentialed)",
        "Failed or stale scrapes are retried and escalated (scraper_recovery, escalation, source_health)"
      ]
    },
    {
      "dot": "amber",
      "title": "Trust boundaries",
      "items": [
        "Microsoft 365, club calendar sites, the LLM judge endpoint, and WordPress are external systems outside repository control",
        "GitHub Actions and GitHub Pages run in GitHub's hosted environment and hold their own deploy/publish secrets, separate from scraper credentials",
        "The LLM judge call leaves the trusted pipeline to an external inference endpoint for plan critique only, not for scheduling decisions"
      ]
    },
    {
      "dot": "violet",
      "title": "Stage 4 export outputs",
      "items": [
        "Excel workbook, iCal feed, and CSV export",
        "Spond app export (spond_exporter)",
        "Per-club review packets for manual club sign-off",
        "Static HTML / GitHub Pages bundle (pages_bundle, pages_publish)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Operator review gate",
      "items": [
        "operator_loop and operator_action collect manual decisions on scraper conflicts and cancellations",
        "manual_adjustment_workflow and cancellation_workflow route edge cases to the operator before approval",
        "No plan reaches Stage 4 export without passing this manual gate"
      ]
    }
  ]
