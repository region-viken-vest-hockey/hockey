{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    ".pi/extensions/**/*.ts",
    ".pi/lib/**/*.ts"
  ],
  "exclude": [
    ".pi/**/*.test.ts",
    ".pi/**/node_modules/**"
  ]
}
