#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT_DIR"

if [[ -x "$ROOT_DIR/venv/bin/python3" ]]; then
  PYTHON_CMD="$ROOT_DIR/venv/bin/python3"
else
  PYTHON_CMD=${PYTHON:-python3}
fi

PHASE_TIMINGS=()

phase() {
  echo ""
  echo "==> $*"
}

run_phase() {
  local name=$1
  shift
  phase "$name"
  local start=$SECONDS
  "$@"
  PHASE_TIMINGS+=("$name=$((SECONDS - start))s")
}

# Like ``run_phase`` but tolerates pytest's "no tests collected" exit code (5),
# so an empty optional lane (e.g. ``harness``) is a visible no-op rather than a
# failure. It never hides a real test failure.
run_phase_tolerant() {
  local name=$1
  shift
  phase "$name"
  local start=$SECONDS
  local rc=0
  "$@" || rc=$?
  PHASE_TIMINGS+=("$name=$((SECONDS - start))s")
  if [[ $rc -eq 5 ]]; then
    echo "(no tests selected for this phase)"
    return 0
  fi
  return $rc
}

print_timings() {
  if [[ ${#PHASE_TIMINGS[@]} -eq 0 ]]; then
    return
  fi
  echo ""
  echo "Phase timings:"
  local entry
  # Guard the (possibly empty) array expansion so this also works under
  # bash 3.2 + `set -u` (macOS system bash).
  for entry in ${PHASE_TIMINGS[@]+"${PHASE_TIMINGS[@]}"}; do
    echo "  $entry"
  done
}

usage() {
  cat <<'EOF'
Usage: scripts/check [phase ...]

With no phase, runs the default quick/PR verification tier.
CI jobs may invoke individual phases so the command sequence is still owned by
this script while GitHub keeps separate visible status checks.

Quick/PR tier phases:
  dependency-lock    verify requirements.lock is fresh from pyproject.toml
  lint               ruff check . (pyflakes + pycodestyle-error rules only)
  quick              fast pytest suite (excludes slow/integration/harness/live)
  operator           operator manifest/escalation control-path tests
  reproducibility    deterministic planner reproducibility fixture
  cli-smoke          integration-marked CLI smoke test
  cli-contracts      public CLI contract suite (subprocess, hermetic)
  rules-report       regenerate/check rules report documentation
  rule-catalog       check canonical rule catalog doc + conformance guards
  architecture-docs  validate semantic architecture diagrams and owner links
  secret-scan        run scripts/secret-scan.sh
  all                all quick/PR tier phases above

Full hermetic lane (scheduled/manual; not every PR):
  slow               hermetic slow tests (real canonical workbook/planner)
  integration        hermetic/local integration tests (subprocess/multi-stage)
  full-tests         quick + slow + hermetic integration in one pytest run
  full               lint + full-tests + rules-report + rule-catalog + architecture-docs

Separated non-blocking lanes (never part of quick or full):
  live               live external-source/network tests (opt-in; see below)
  harness            tests that require a specific external agent/tool runtime

Environment:
  SKIP_SECRET_SCAN=1 skips secret-scan in the all phase only.
  RVV_LIVE_TESTS=1   allow live tests to run (the live phase sets it itself).
EOF
}

run_named_phase() {
  case "$1" in
    dependency-lock)
      run_phase "Python dependency lock freshness" env RVV_CHECK_PYTHON="$PYTHON_CMD" bash -c '
        set -euo pipefail
        tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/rvv-pip-tools.XXXXXX")
        trap "rm -rf \"$tmp_dir\"" EXIT
        "$RVV_CHECK_PYTHON" -m venv "$tmp_dir"
        "$tmp_dir/bin/python" -m pip install --quiet --upgrade "pip<26" "pip-tools==7.6.0"
        before_lock="$tmp_dir/requirements.lock.before"
        cp requirements.lock "$before_lock"
        PYTHON="$RVV_CHECK_PYTHON" PIP_COMPILE_BIN="$tmp_dir/bin/pip-compile" scripts/refresh-python-lock.sh >/tmp/rvv-refresh-python-lock.out 2>&1
        if ! cmp -s "$before_lock" requirements.lock; then
          echo "ERROR: requirements.lock is stale. Run scripts/refresh-python-lock.sh and commit the result." >&2
          diff -u "$before_lock" requirements.lock >&2 || true
          exit 1
        fi
      '
      ;;
    lint)
      run_phase "Ruff lint" "$PYTHON_CMD" -m ruff check .
      ;;
    file-length)
      # Disabled: the 300-line-per-file guideline is no longer enforced.
      echo "File-length guideline check is disabled."
      ;;
    quick)
      run_phase "Fast Python test suite" "$PYTHON_CMD" -m pytest --no-cov -q
      ;;
    operator)
      run_phase "Operator manifest and escalation tests" "$PYTHON_CMD" -m pytest --no-cov -v \
        tests/test_run_manifest.py \
        tests/test_capability_result.py \
        tests/test_escalation.py \
        tests/test_operator_run.py
      ;;
    reproducibility)
      run_phase "Deterministic planner reproducibility" "$PYTHON_CMD" -m pytest --no-cov -v tests/test_reproducibility.py --basetemp=repro-tmp
      ;;
    cli-smoke)
      run_phase "CLI integration smoke test" "$PYTHON_CMD" -m pytest --no-cov -v -m integration tests/test_cli_smoke.py --basetemp=cli-smoke-tmp
      ;;
    cli-contracts)
      run_phase "Public CLI contract suite" "$PYTHON_CMD" -m pytest --no-cov -q -m integration tests/test_cli_contract.py
      ;;
    slow)
      run_phase "Hermetic slow tests (canonical workbook/planner)" "$PYTHON_CMD" -m pytest --no-cov -q -m slow
      ;;
    integration)
      run_phase "Hermetic/local integration tests" "$PYTHON_CMD" -m pytest --no-cov -q -m integration
      ;;
    full-tests)
      # One run over every hermetic test: quick + slow + integration. The
      # command-line -m overrides the addopts default so nothing is skipped
      # twice, and durations make a performance regression visible.
      run_phase "Full hermetic test suite (quick + slow + integration)" \
        "$PYTHON_CMD" -m pytest --no-cov -q --durations=25 -m "not live and not harness"
      ;;
    full)
      run_full
      ;;
    live)
      run_phase_tolerant "Live external-source tests" \
        env RVV_LIVE_TESTS=1 "$PYTHON_CMD" -m pytest --no-cov -q -m live
      ;;
    harness)
      run_phase_tolerant "Harness-dependent tests" "$PYTHON_CMD" -m pytest --no-cov -q -m harness
      ;;
    rules-report)
      run_phase "Rules report sync" env PYTHON="$PYTHON_CMD" sh scripts/rules-report.sh
      ;;
    rule-catalog)
      run_phase "Rule catalog sync and guards" env RVV_CHECK_PYTHON="$PYTHON_CMD" bash -c '
        set -euo pipefail
        "$RVV_CHECK_PYTHON" scripts/render-rule-catalog.py --check
        "$RVV_CHECK_PYTHON" -m pytest --no-cov -q tests/test_rule_catalog.py
      '
      ;;
    architecture-docs)
      run_phase "Semantic architecture drift check" "$PYTHON_CMD" scripts/check-architecture-docs.py
      ;;
    secret-scan)
      run_phase "Secret scan" sh scripts/secret-scan.sh
      ;;
    all)
      run_all
      ;;
    -h|--help|help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown check phase '$1'" >&2
      usage >&2
      exit 2
      ;;
  esac
}

run_all() {
  local phases=(dependency-lock lint quick operator reproducibility cli-smoke cli-contracts rules-report rule-catalog architecture-docs)
  for named_phase in "${phases[@]}"; do
    run_named_phase "$named_phase"
  done
  if [[ "${SKIP_SECRET_SCAN:-0}" == "1" ]]; then
    phase "Secret scan skipped (SKIP_SECRET_SCAN=1)"
  else
    run_named_phase secret-scan
  fi
}

run_full() {
  local phases=(lint full-tests rules-report rule-catalog architecture-docs)
  for named_phase in "${phases[@]}"; do
    run_named_phase "$named_phase"
  done
}

if [[ $# -eq 0 ]]; then
  run_all
else
  for requested_phase in "$@"; do
    run_named_phase "$requested_phase"
  done
fi

print_timings

echo ""
echo "✅ Canonical checks passed"
