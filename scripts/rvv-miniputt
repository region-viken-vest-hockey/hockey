#!/usr/bin/env bash
set -euo pipefail

# Thin repository launcher used by non-Pi harness adapters.
# All command behavior lives in tournament_scheduler.cli.rvv_cli; this wrapper
# only selects the repository virtualenv when it exists.
ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
PYTHON_BIN="$ROOT_DIR/venv/bin/python3"

if [[ -x "$PYTHON_BIN" ]]; then
  PYTHON_CMD="$PYTHON_BIN"
else
  PYTHON_CMD=python3
fi

exec "$PYTHON_CMD" -m tournament_scheduler.cli.rvv_cli "$@"
